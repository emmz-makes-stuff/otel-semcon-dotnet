<Project Sdk="Microsoft.NET.Sdk">

  <!-- Identity comes from Package.props at the repository root. -->
  <PropertyGroup>
    <AssemblyName>$(SemanticConventionsRootNamespace).Incubating</AssemblyName>
    <RootNamespace>$(AssemblyName)</RootNamespace>
    <PackageId>$(AssemblyName)</PackageId>
    <Description>All OpenTelemetry semantic conventions for .NET, including experimental and deprecated ones, generated with OpenTelemetry Weaver. Stable definitions are marked [Obsolete] and point to $(SemanticConventionsRootNamespace).</Description>
  </PropertyGroup>

</Project>
